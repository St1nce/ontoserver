    <owl:Class rdf:about="http://www.semanticweb.org/regul/ontologies/2021/9/untitled-ontology-12#LearnerID">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/regul/ontologies/2021/9/untitled-ontology-12#LearnerID"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:complementOf>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/regul/ontologies/2021/9/untitled-ontology-12#hasIQ1"/>
                                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</owl:hasValue>
                                    </owl:Restriction>
                                </owl:complementOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/regul/ontologies/2021/9/untitled-ontology-12#isRecommended"/>
                                <owl:hasValue rdf:resource="http://www.semanticweb.org/regul/ontologies/2021/7/untitled-ontology-2#finalTest"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


