                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/regul/ontologies/2021/7/untitled-ontology-2#F_Assessment"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/regul/ontologies/2021/7/untitled-ontology-2#hasFunction"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/regul/ontologies/2021/7/untitled-ontology-2#F_Education"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
